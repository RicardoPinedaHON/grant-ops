# Copy this file to .env and fill in your values

# Notion integration (get token at notion.so/my-integrations)
NOTION_TOKEN=ntn_...
NOTION_DB_ID=your-database-id-here

# Brave Search API — used to find missing deadline/amount data for grants
# Get a free key at: https://api.search.brave.com/
BRAVE_SEARCH_KEY=
