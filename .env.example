# Copy this file to .env and fill in your values

# Notion integration (get token at notion.so/my-integrations)
NOTION_TOKEN=ntn_...
NOTION_DB_ID=your-database-id-here

# Brave Search API — used to find missing deadline/amount data for grants
# Get a free key at: https://api.search.brave.com/
BRAVE_SEARCH_KEY=

# Microsoft Graph API — Outlook inbox scanner for grant newsletters
# Setup: register a free Azure app, then run: node scripts/auth-outlook.js
# Guide: see README or ask Claude Code for step-by-step instructions
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=common
GRAPH_EMAIL_FOLDER=Grant Newsletters
