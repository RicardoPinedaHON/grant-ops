# Copy this file to .env and fill in your values

# Notion integration (get token at notion.so/my-integrations)
NOTION_TOKEN=ntn_...
NOTION_DB_ID=your-database-id-here

# Brave Search API — used to find missing deadline/amount data for grants
# Get a free key at: https://api.search.brave.com/
BRAVE_SEARCH_KEY=

# Microsoft Graph API — Outlook inbox scanner for grant newsletters
# Setup: register a free Azure app, then run: node scripts/auth-outlook.js
# Guide: see README or ask Claude Code for step-by-step instructions
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=common
GRAPH_EMAIL_FOLDER=Grant Newsletters

# Jina Reader — used by the LinkedIn source (src/scrapers/linkedin.js) to
# fetch public company pages. OPTIONAL — LinkedIn scraping works with no
# key at all, anonymously, for normal/light use. This only matters if you
# hit Jina's anonymous per-IP rate limit and see a message about needing
# an API key: get a FREE key (no payment required) at https://jina.ai/reader
# and paste it here. If you'd rather not deal with it at all, set
# linkedin.enabled: false in config/sources.yaml — every other source
# still works fine without LinkedIn.
JINA_API_KEY=
